-    std::string_view topicName)
-    : NetworkBooleanEvent{loop, table->GetBooleanTopic(topicName)} {}
+    EventLoop* loop, prosdk::tunables::Tunable<bool> tunable)
+    : BooleanEvent{loop, MakeSignal(std::make_shared<BooleanTunable>(
+                             std::move(tunable)))} {}
 
