+++ b/src/prosdk/thirdparty/sleipnir/sleipnir/autodiff/expression.hpp
@@ -24,7 +24,10 @@ namespace slp::detail {
 
 // The global pool allocator uses a thread-local static pool resource, which
 // isn't guaranteed to be initialized properly across DLL boundaries on Windows
-#ifdef _WIN32
+//
+// prosdk: also off on the ESP32. The pool grabs 16384 blocks (about 800 KB) per
+// thread on first use; expressions use plain new/delete there instead.
+#if defined(_WIN32) || PROSDK_TARGET_HW
 inline constexpr bool USE_POOL_ALLOCATOR = false;
 #else
 inline constexpr bool USE_POOL_ALLOCATOR = true;
