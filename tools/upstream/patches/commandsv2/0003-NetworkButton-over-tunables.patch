-                             std::string_view field)
-    : NetworkButton(table->GetBooleanTopic(field)) {}
+NetworkButton::NetworkButton(std::string_view path)
+    : Trigger([value = GetButtonValue(path)] {
+        return prosdk::RobotState::IsDSAttached() && value->Get();
+      }) {}
 
